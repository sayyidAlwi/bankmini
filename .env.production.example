# =============================================================================
# Contoh konfigurasi produksi BankMini.
#
# Cara pakai di hosting:
#   1. Salin file ini menjadi .env  ->  cp .env.production.example .env
#   2. Ganti semua nilai bertanda GANTI-...
#   3. php artisan key:generate --force
#   4. php artisan config:cache
#
# Jangan pernah meng-commit file .env yang sudah berisi kredensial asli.
# =============================================================================

APP_NAME="BankMini"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://GANTI-DOMAIN-ANDA.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database MySQL dari cPanel/hosting.
# Jangan memakai DB_CONNECTION=sqlite di hosting.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=GANTI-NAMA-DATABASE
DB_USERNAME=GANTI-USER-DATABASE
DB_PASSWORD=GANTI-PASSWORD-DATABASE

# Sesi dan cache disimpan di database (tabel sudah disediakan oleh migration).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true bila domain memakai HTTPS.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Aplikasi ini tidak memakai job antrean, jadi sync lebih sederhana dan aman.
# Ubah ke database + jalankan queue worker bila nanti menambah job.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Email dinonaktifkan (ditulis ke log). Ganti ke smtp bila notifikasi email dipakai.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@bankmini.sekolah.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
